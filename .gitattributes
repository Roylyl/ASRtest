# Auto detect text files and perform LF normalization
* text=auto

# These trees carry checksummed or fixed-revision upstream bytes. Do not let
# platform line-ending conversion change the material represented by manifests
# and archive hashes.
ModelLibrary/** -text
Packages/**/*.xcframework/** -text
Vendor/** -text

# Model weights and compiled runtimes are versioned with Git LFS. Keep these
# rules before the first commit that contains the corresponding files.
*.onnx filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.fst filter=lfs diff=lfs merge=lfs -text
*.mdl filter=lfs diff=lfs merge=lfs -text
*.ie filter=lfs diff=lfs merge=lfs -text
*.dubm filter=lfs diff=lfs merge=lfs -text
*.mat filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
**/whisper.framework/whisper filter=lfs diff=lfs merge=lfs -text
**/CNano.framework/CNano filter=lfs diff=lfs merge=lfs -text
