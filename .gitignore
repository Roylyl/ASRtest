# macOS / editors
.DS_Store
._*
.Trashes/
.idea/
.vscode/
*.swp
*.swo
*~
# Xcode and SwiftPM generated state; keep shared schemes and Package.resolved
xcuserdata/
*.xcuserstate
.swiftpm/
.build/
.build-native/
**/.build/
**/.build-native/
DerivedData/
Build/
build/
*.app/
*.ipa
*.xcarchive/
*.xcresult/
*.dSYM/
*.dSYM.zip
*.hmap
*.o
*.dylib
*.swiftmodule
*.swiftdoc
*.swiftsourceinfo
*.abi.json
# Personal signing, credentials and local evidence
/apps/ios/Config/Local.xcconfig
/LocalBackup/
.env
.env.*
!.env.example
*.p12
*.pfx
*.p8
*.pem
*.key
*.mobileprovision
*.provisionprofile
# Test outputs may contain speech, machine paths, simulator IDs and device data
/apps/ios/Tests/**/*.json
/apps/ios/Tests/**/*.jsonl
/apps/ios/Tests/**/*.log
/apps/ios/Tests/core-smoke/
/apps/ios/Tests/model-store-build/
/apps/ios/Tests/UITests/Artifacts/
/apps/ios/Tests/runtime-link-shared-device
/apps/ios/Tests/runtime-link-shared-simulator
/apps/ios/Tests/runtime-link-static-device
/apps/ios/Tests/runtime-link-static-simulator
/apps/ios/Tests/standard-engine-smoke
/apps/ios/Tests/nano/swift-simulator
/apps/ios/Tests/nano/coexist-simulator
*.f32
/apps/ios/Tests/**/*.wav
/apps/ios/Tests/**/*.mp3
/apps/ios/Tests/**/*.m4a
/apps/ios/Tests/**/*.pcm
/apps/ios/Tests/**/*.png
/apps/ios/Tests/2026-09-23-expansion/project.pbxproj-before-iphone-only
# Superseded reports and non-public generated screenshots
/docs/*调整前*
/docs/*更新前*
/docs/screenshots/ios/*
!/docs/screenshots/ios/ui-test-light.png
!/docs/screenshots/ios/ui-test-dark.png
!/docs/screenshots/ios/ui-model-selector-light.png
!/docs/screenshots/ios/ui-logs-light.png
!/docs/screenshots/ios/ui-settings-light.png
!/docs/screenshots/ios/ui-models-light.png
# Python / CMake caches
__pycache__/
*.py[cod]
.venv/
**/.git/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Vendor contains clean, fixed-revision upstream source snapshots. Preserve
# every upstream-tracked file even when a global ignore rule would normally
# hide files such as .idea metadata, build scripts, Podfiles, or static libs.
!/Vendor/
!/Vendor/**
# Finder metadata is generated locally, including inside preserved vendor sources.
Vendor/**/.DS_Store
/Vendor/**/.git/
/Vendor/**/.build/

# XCFrameworks are released project artifacts. Repository rules override a
# developer's global *.a ignore so every declared slice remains versioned.
!/apps/ios/Packages/**/*.xcframework/
!/apps/ios/Packages/**/*.xcframework/**
!/apps/ios/WatchWhisperRuntime/
!/apps/ios/WatchWhisperRuntime/WatchWhisper.xcframework/
!/apps/ios/WatchWhisperRuntime/WatchWhisper.xcframework/**

# Android local configuration and generated outputs
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
local.properties
*.iml
*.apk
*.aab
*.jks
*.keystore
/apps/android/results/
/apps/android/evaluation/runs/
/apps/android/evaluation/report/
/apps/android/dist/
/apps/android/native/build.log
# Superseded Android README is retained locally for migration reference only.
/apps/android/README.before-monorepo.md

# Platform-specific dependencies are checked-in runtime artifacts.
!/apps/android/app/libs/
!/apps/android/app/libs/*.aar
!/apps/android/app/libs/*.jar
!/apps/android/app/src/main/jniLibs/
!/apps/android/app/src/main/jniLibs/**
# Keep Finder metadata ignored even inside explicitly preserved artifacts.
.DS_Store
._*
