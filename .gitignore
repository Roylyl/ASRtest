# Superseded reports and non-public generated screenshots
/Documentation/*调整前*
/Documentation/*更新前*
/Preview/*
!/Preview/ui-test-light.png
!/Preview/ui-test-dark.png
!/Preview/ui-model-selector-light.png
!/Preview/ui-logs-light.png
!/Preview/ui-settings-light.png
!/Preview/ui-models-light.png
# Python / CMake caches
__pycache__/
*.py[cod]
.venv/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Vendor contains clean, fixed-revision upstream source snapshots. Preserve
# every upstream-tracked file even when a global ignore rule would normally
# hide files such as .idea metadata, build scripts, Podfiles, or static libs.
!/Vendor/
!/Vendor/**
/Vendor/**/.git/
/Vendor/**/.build/

# XCFrameworks are released project artifacts. Repository rules override a
# developer's global *.a ignore so every declared slice remains versioned.
!/Packages/**/*.xcframework/
!/Packages/**/*.xcframework/**
